# Firebase Configuration (Use environment variables instead)
# Add these to your .env or Expo secrets

# Firebase Web Config - REPLACE WITH YOUR CONFIG
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Claude API Key - Add your API key here
EXPO_PUBLIC_CLAUDE_API_KEY=your_claude_api_key

# Notes:
# 1. Never commit this file with real keys to version control
# 2. Add .env to .gitignore
# 3. Use Expo Secrets for production: https://docs.expo.dev/build/variables/
# 4. For Firebase, consider using private keys only on backend
