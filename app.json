{
  "expo": {
    "name": "Reversia",
    "slug": "DiabetesApp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/Reversia_logo_png.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Reversia_logo_png.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1FF",
      "hidden": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xtreemtech.reversia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Reversia needs access to your camera to scan and analyze your meals.",
        "NSMicrophoneUsageDescription": "Reversia needs access to your microphone to transcribe voice meal descriptions.",
        "NSPhotoLibraryUsageDescription": "Reversia needs access to your photo library to select meal photos."
      }
    },
    "android": {
      "package": "com.xtreemtech.reversia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Reversia_logo_png.png",
        "backgroundColor": "#F5F1FF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Reversia needs access to your camera to scan and analyze your meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reversia needs access to your photos to allow you to select meal photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#8055E8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eae4d01c-163d-40d0-8b50-c2bf86dcf194"
      }
    },
    "owner": "xtreemtech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eae4d01c-163d-40d0-8b50-c2bf86dcf194"
    }
  }
}
